# X Intelligence MCP configuration
NODE_ENV=development
PORT=3000
# Local development binds to loopback. Hosted production should use HOST=0.0.0.0.
HOST=127.0.0.1
MCP_TRANSPORT_TYPE=dual
DEMO_CANVAS_MODE=false
NITRO_LOG_LEVEL=info

# Personal X API credentials. Use a user access token for /2/users/me and writes.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_BEARER_TOKEN=
X_AUTH_ENABLED=false
X_REDIRECT_URI=http://127.0.0.1:3000/auth/x/callback
X_SCOPES=tweet.read tweet.write users.read follows.read follows.write like.read like.write media.write offline.access
X_API_BASE_URL=https://api.x.com
X_API_TIMEOUT_MS=15000
X_API_MAX_RETRIES=1

# Optional Phase 3 AI layer. Leave disabled until a provider key and model are configured.
AI_ENABLED=false
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_INPUT_CHARS=60000
AI_MAX_SAMPLED_POSTS=30

# NitroStack MCP OAuth protection
OAUTH_REQUIRED=false
RESOURCE_URI=https://mcplocal
AUTH_SERVER_URL=
# AUTH0_AUDIENCES accepts a comma- or space-separated allowlist. The legacy
# TOKEN_AUDIENCE setting remains supported and is included for compatibility.
AUTH0_AUDIENCE=
AUTH0_AUDIENCES=
TOKEN_AUDIENCE=
TOKEN_ISSUER=https://x-intelligence-mcp.au.auth0.com/
JWKS_URI=
INTROSPECTION_ENDPOINT=
INTROSPECTION_CLIENT_ID=
INTROSPECTION_CLIENT_SECRET=
# MCP_API_KEY is not used by this OAuth-bound MCP transport; keep it unset.
MCP_API_KEY=

# Production requires OAUTH_REQUIRED=true, an HTTPS RESOURCE_URI and
# exactly one verifier: JWKS_URI (+ TOKEN_ISSUER) or introspection (+ its client credentials).

# Optional application URL
APP_BASE_URL=http://127.0.0.1:3000
