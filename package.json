{
  "name": "x-intelligence-mcp",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "AI-ready MCP server for interacting with X, retrieving real X data, and performing grounded AI analysis and content drafting.",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "dev:http": "npm run build && MCP_TRANSPORT_TYPE=dual PORT=3000 HOST=127.0.0.1 NODE_ENV=development node dist/index.js",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "test": "npm run build && node --test --test-force-exit test/**/*.test.mjs",
    "integration:smoke": "npm run build && node dist/integration/smoke.js",
    "test:ai:integration": "npm run build && node scripts/test-ai-provider.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:remote-mcp": "node scripts/test-remote-mcp.mjs",
    "test:chatgpt": "node scripts/test-chatgpt-compatibility.mjs",
    "test:claude": "node scripts/test-claude-compatibility.mjs",
    "test:claude:tools": "node scripts/test-claude-tools.mjs",
    "test:nitrostudio": "npm run build && node scripts/test-nitrostudio-demo.mjs",
    "test:nitrostudio-demo": "npm run test:nitrostudio",
    "verify:demo-tools": "npm run build && node scripts/verify-demo-tools.mjs",
    "widget:typecheck": "npm --prefix src/widgets exec tsc -- --noEmit",
    "widget:build": "npm --prefix src/widgets run build",
    "validate": "npm run build && npm run widget:typecheck && npm test"
  },
  "dependencies": { "@nitrostack/core": "^1.0.15", "@modelcontextprotocol/ext-apps": ">=0.1.0", "dotenv": "^16.3.1", "zod": "^3.22.4", "zod-to-json-schema": "^3.25.2" },
  "devDependencies": { "@nitrostack/cli": "^1.0.15", "@types/node": "^22.10.0", "typescript": "^5.3.3" },
  "author": ""
}
